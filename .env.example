# Database - none needed. Storage is local SQLite at ./data/local.db (created
# automatically on first run). Run `npm run db:push` to create the tables.

# OpenRouter - Get from https://openrouter.ai/keys
# This lets you query ChatGPT, Claude, Gemini, Perplexity, etc. through one API
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI - Get from https://platform.openai.com/api-keys
# Used for generating embeddings (concept similarity)
OPENAI_API_KEY=sk-...

# API Secret - Protects all /api/ routes when deployed
# Generate one with: openssl rand -hex 32
# Leave empty for local dev (no auth required)
API_SECRET=

# App URL - Change to your deployed URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
